{
  "name": "papernote",
  "version": "2.0.0",
  "author": "Papernote",
  "description": "A quiet, local-first writing app.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && node electron/name-dev-app.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "preview": "vite",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/sometype-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.papernote.app",
    "productName": "Papernote",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
